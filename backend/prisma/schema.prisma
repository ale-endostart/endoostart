generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ContentType {
  PDF
  VIDEO
  TEXT
  LINK
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String?
  googleId          String?  @unique
  firstName         String
  lastName          String
  crm               String?  @unique
  phone             String?
  state             String?
  role              Role     @default(STUDENT)
  hasAccess         Boolean  @default(false)
  accessGrantedAt   DateTime?
  accessRevokedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments       StudentCourse[]
  downloads         Download[]
  activityLogs      ActivityLog[]
  analyticsEvents   Analytics[]
  completions       LessonCompletion[]
  comments          Comment[]

  @@index([email])
  @@index([role])
  @@index([hasAccess])
}

model Course {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  description       String     @db.Text
  shortDescription  String
  price             Float
  durationWeeks     Int
  difficulty        Difficulty
  imageUrl          String     @default("")
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  modules           Module[]
  enrollments       StudentCourse[]

  @@index([slug])
  @@index([isActive])
}

model Module {
  id                String   @id @default(cuid())
  courseId           String
  name              String
  description       String   @db.Text
  order             Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons           Lesson[]

  @@index([courseId])
  @@index([order])
}

model Lesson {
  id                String   @id @default(cuid())
  moduleId          String
  name              String
  description       String   @db.Text
  order             Int
  duration          Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module            Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contents          Content[]
  completions       LessonCompletion[]
  comments          Comment[]

  @@index([moduleId])
  @@index([order])
}

model Content {
  id                String      @id @default(cuid())
  lessonId          String
  type              ContentType
  title             String
  description       String      @db.Text
  url               String
  fileSize          Float?
  mimeType          String?
  order             Int
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lesson            Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  downloads         Download[]

  @@index([lessonId])
  @@index([type])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model StudentCourse {
  id                String   @id @default(cuid())
  studentId         String
  courseId           String
  enrolledAt        DateTime @default(now())
  accessGrantedAt   DateTime?
  accessRevokedAt   DateTime?
  isActive          Boolean  @default(true)
  progress          Int      @default(0)
  completedAt       DateTime?

  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([isActive])
}

model Download {
  id                String   @id @default(cuid())
  studentId         String
  contentId         String
  downloadedAt      DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content           Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([contentId])
  @@index([downloadedAt])
}

model ActivityLog {
  id                String   @id @default(cuid())
  studentId         String
  eventType         String
  metadata          Json?
  timestamp         DateTime @default(now())

  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([eventType])
  @@index([timestamp])
}

model Analytics {
  id                String   @id @default(cuid())
  eventType         String
  studentId         String?
  metadata          Json?
  timestamp         DateTime @default(now())

  student           User?    @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([timestamp])
  @@index([studentId])
}

model Comment {
  id          String    @id @default(cuid())
  lessonId    String
  userId      String
  parentId    String?
  content     String    @db.Text
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
}

model PlatformSettings {
  id          String   @id @default("default")
  platformName String  @default("EndoStart")
  logoUrl     String   @default("")
  faviconUrl  String   @default("")
  primaryColor String  @default("#16a34a")
  accentColor  String  @default("#22c55e")
  footerText  String   @default("")
  whatsappNumber String @default("")
  updatedAt   DateTime @updatedAt
}
